<?php

namespace App\Http\Controllers\Admin;

use App\Http\Requests\{{Model}}Request;
use Backpack\CRUD\app\Http\Controllers\CrudController;
use Backpack\CRUD\app\Library\CrudPanel\CrudPanelFacade as CRUD;

/**
 * {{Model}} CRUD panel (Backpack v6 + PRO).
 *
 * Route (routes/backpack/custom.php): Route::crud('{{segment}}', '{{Model}}CrudController');
 * Menu  (menu_items.blade.php):       <x-backpack::menu-item title="{{Models}}" icon="la la-list" :link="backpack_url('{{segment}}')" />
 *
 * @property-read \Backpack\CRUD\app\Library\CrudPanel\CrudPanel $crud
 */
class {{Model}}CrudController extends CrudController
{
    use \Backpack\CRUD\app\Http\Controllers\Operations\ListOperation;
    use \Backpack\CRUD\app\Http\Controllers\Operations\CreateOperation;
    use \Backpack\CRUD\app\Http\Controllers\Operations\UpdateOperation;
    use \Backpack\CRUD\app\Http\Controllers\Operations\DeleteOperation;
    use \Backpack\CRUD\app\Http\Controllers\Operations\ShowOperation;
    // PRO (enable what you need):
    // use \Backpack\CRUD\app\Http\Controllers\Operations\FetchOperation;
    // use \Backpack\CRUD\app\Http\Controllers\Operations\InlineCreateOperation; // must come AFTER CreateOperation
    // use \Backpack\CRUD\app\Http\Controllers\Operations\BulkDeleteOperation;
    // use \Backpack\CRUD\app\Http\Controllers\Operations\CloneOperation;
    // use \Backpack\Pro\Http\Controllers\Operations\TrashOperation;              // replaces DeleteOperation (model needs SoftDeletes)

    public function setup()
    {
        CRUD::setModel(\App\Models\{{Model}}::class);
        CRUD::setRoute(config('backpack.base.route_prefix').'/{{segment}}');
        CRUD::setEntityNameStrings('{{model singular}}', '{{model plural}}');

        // Access rules that apply to every operation:
        // if (! backpack_user()->can('{{table}}.edit')) { CRUD::denyAccess(['create', 'update', 'delete']); }
    }

    protected function setupListOperation()
    {
        CRUD::column('name');
        // CRUD::column('category');                                  // relationship column (PRO)
        // CRUD::column('price')->type('number')->prefix('$')->decimals(2);
        // CRUD::column('is_active')->type('boolean');
        // CRUD::column('created_at')->type('datetime');

        // CRUD::filter('is_active')->type('simple')->whenActive(fn () => CRUD::addClause('where', 'is_active', 1));

        // if (! CRUD::getRequest()->has('order')) { CRUD::orderBy('created_at', 'desc'); }
        // CRUD::enableExportButtons();
    }

    protected function setupCreateOperation()
    {
        CRUD::setValidation({{Model}}Request::class);

        CRUD::field('name')->size(6);
        // CRUD::field('category')->type('relationship')->ajax(true)->inline_create(true)->size(6);
        // CRUD::field('price')->type('number')->prefix('$')->attributes(['step' => 'any'])->size(6);
        // CRUD::field('is_active')->type('switch')->default(true);
        // CRUD::field('image')->type('image')->withFiles(['disk' => 'public', 'path' => '{{segment}}']);
        // CRUD::field('description')->type('summernote')->tab('Details');
    }

    protected function setupUpdateOperation()
    {
        $this->setupCreateOperation();
    }

    protected function setupShowOperation()
    {
        $this->setupListOperation();
    }

    // Needed when an upload field should delete its files on entry delete:
    // protected function setupDeleteOperation()
    // {
    //     CRUD::field('image')->type('image')->withFiles(['disk' => 'public', 'path' => '{{segment}}']);
    // }

